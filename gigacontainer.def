Bootstrap: docker
From: debian:13.6

%labels
    Author William Redding
%files
    main.nf /opt/pipeline/
    workflows /opt/pipeline/
    nextflow.config /opt/pipeline/
    containers /opt/pipeline/containers
    containers.sh /opt/pipeline/
    pixi.lock /opt/pipeline/
    pixi.toml /opt/pipeline/
    apptainer-cache/samtools.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/helixer.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/ingenannot.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/tiberius.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/bedtools.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/annevo.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/miniprot.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/cutadapt.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/star.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/braker3.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/stringtie.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/samtools.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/isoseq.sif /opt/pipeline/apptainer-cache/
    apptainer-cache/pbmm2.sif /opt/pipeline/apptainer-cache/
%environment 
    export PIXI_PROJECT_MANIFEST=/opt/pipeline/pixi.toml
    export NXF_OFFLINE='true'
%post
    set -e
    apt-get update
    apt-get install -y wget vim ca-certificates less which locales-all procps
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    cd /opt/pipeline
    wget -qO- https://pixi.sh/install.sh | PIXI_HOME=/usr/local sh
    pixi config set mirrors '{"https://conda.anaconda.org/": ["https://prefix.dev/"]}'
    pixi install -e apptainer
%runscript
    exec pixi run -e apptainer nextflow run /opt/pipeline/main.nf -c /opt/pipeline/nextflow.config -profile local "$@"
