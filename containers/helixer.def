Bootstrap: docker
From: gglyptodon/helixer-docker:helixer_v0.3.7_cuda_12.2.2-cudnn8_1

%post
    sed -i "s|MODEL_LIST_URL = 'https://raw.githubusercontent.com/weberlab-hhu/Helixer/main/resources/model_list.csv'|MODEL_LIST_URL = None|" /home/helixer_user/Helixer/helixer/core/data.py
    sed -i "s|response = urllib.request.urlopen(MODEL_LIST_URL)|# response = urllib.request.urlopen(MODEL_LIST_URL)|" /home/helixer_user/Helixer/helixer/core/data.py
    mkdir -p /opt/helixer/models
    /home/helixer_user/Helixer/scripts/fetch_helixer_models.py -a -c /opt/helixer/models