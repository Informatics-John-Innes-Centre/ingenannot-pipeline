// nextflow.config
outputDir = 'results'

params {
    slurm_queue = null
    slurm_gpu_queue = null
}

profiles {
    local {
        process {
            executor = 'local'
        }
    }

    hpc {
        executor {
            name = 'slurm'
        }

        process {
            queue = params.slurm_queue

            withLabel: 'gpu' {
                queue = params.slurm_gpu_queue
            }
        }
    }
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = "${projectDir}/apptainer-cache"
}

process {
    withName: 'softmask' {
        container      = 'bedtools.sif'
        memory         = 8.GB
        time           = 2.h
        cpus           = 1
    }

    withName: 'helixer' {
        container        = 'helixer.sif'
        containerOptions = '--nv'
        memory           = 100.GB
        time             = 2.d
        cpus             = 1
        clusterOptions   = '--gres=gpu:1'
    }

    withName: 'annevo' {
        container        = 'annevo-fix.sif'
        containerOptions = '--nv'
        memory           = 950.GB
        time             = 2.d
        cpus             = 32
        clusterOptions   = '--gres=gpu:1'
    }

    withName: 'tiberius' {
        container        = 'tiberius-2.0.6.sif'
        containerOptions = '--nv'
        memory           = 400.GB
        time             = 2.d
        cpus             = 1
        clusterOptions = '--gres=gpu:1'
    }

    withName: 'miniprot_alignment' {
        container      = 'miniprot.sif'
        memory         = 300.GB
        time           = 7.d
        cpus           = 32
    }

    withName: 'star_index' {
        container      = 'star.sif'
        memory         = 100.GB
        time           = 1.d
        cpus           = 4
    }

    withName: 'trim_rnaseq_data' {
        container      = 'cutadapt.sif'
        memory         = 4.GB
        time           = 1.d
        cpus           = 12
    }

    withName: 'star_map_rnaseq_data_first_pass' {
        container      = 'star.sif'
        memory         = 60.GB
        time           = 1.d
        cpus           = 12
    }

    withName: 'star_map_rnaseq_data_second_pass' {
        container      = 'star.sif'
        memory         = 80.GB
        time           = 1.d
        cpus           = 12
    }

    withName: 'braker3' {
        container      = 'braker3.sif'
        memory         = 256.GB
        time           = 7.d
        cpus           = 8
    }

    withName: 'stringtie_assemble' {
        container      = 'stringtie.sif'
        memory         = 32.GB
        time           = 1.d
        cpus           = 4
    }
    
    withName: 'ingenannot_validate_annotation' {
        container      = 'ingenannot.sif'
        memory         = 16.GB
        time           = 1.d
        cpus           = 1
    }

    withName: 'sort_bgzip_index_miniprot_mappings' {
        container      = 'samtools.sif'
        memory         = 8.GB
        time           = 1.d
        cpus           = 8
    }

    withName: 'combine_stringtie_transcripts' {
        container      = 'stringtie.sif'
        memory         = 2.GB
        time           = 1.d
        cpus           = 1
    }

    withName: 'sort_bgzip_index_combined_stringtie_transcript' {
        container      = 'samtools.sif'
        memory         = 8.GB
        time           = 1.d
        cpus           = 8
    }

    withName: 'create_masked_fasta_minimap_index'  {
        container      = 'pacbio_tools.sif'
        memory         = 64.GB
        time           = 1.d
        cpus           = 1
    }

    withName: 'convert_cram_flnc_to_bam'  {
        container      = 'samtools.sif'
        memory         = 8.GB
        time           = 1.d
        cpus           = 1
    }

    withName: 'align_isoseq_reads_to_genome'  {
        container      = 'pacbio_tools.sif'
        memory         = 64.GB
        time           = 1.d
        cpus           = 8
    }

    withName: 'collapse_isoseq'  {
        container      = 'pacbio_tools.sif'
        memory         = 8.GB
        time           = 1.d
        cpus           = 1
    }

    withName: 'samtools_index' {
        container      = 'samtools.sif'
        memory         = 2.GB
        time           = 1.d
        cpus           = 1
    }

    withName: 'isoform_ranking' {
        container      = 'ingenannot.sif'
        memory         = 256.GB
        time           = 1.d
        cpus           = 1
    }

    withName: 'sort_bgzip_index_top_isoforms' {
        container      = 'samtools.sif'
        memory         = 8.GB
        time           = 1.d
        cpus           = 8
    }

    withName: 'compute_aed_score_for_annotation' {
        container      = 'ingenannot.sif'
        memory         = 64.GB
        time           = 2.d
        cpus           = 8
    }

    withName: 'ingenannot_selection_process' {
        container      = 'ingenannot.sif'
        memory         = 64.GB
        time           = 1.d
        cpus           = 8
    }

    withName: 'ingenannot_compare' {
        container      = 'ingenannot.sif'
        memory         = 64.GB
        time           = 1.d
        cpus           = 8
    }
}
